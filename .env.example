# Livepeer Agent mode: "real" or "mock"
LIVEPEER_MODE=mock

# Livepeer Agent creative MCP endpoint (no key needed for demo credits)
LIVEPEER_ENDPOINT=https://agent.livepeer.org/api/mcp/creative

# Optional: Livepeer API key from app.daydream.live (for unlimited renders)
# LIVEPEER_KEY=sk_your_key_here

# DKG mode: "file" (local JSON-LD snapshots) or "edge" (OriginTrail Edge Node)
DKG_MODE=file

# Server port
PORT=8080
